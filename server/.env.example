# Node A HTTP port (must match nodeA/torrc HiddenServicePort target)
HTTP_PORT=9000

# Node A Tor SOCKS port (must match nodeA/torrc SocksPort)
SOCKS_PORT=10050

# Relative paths are resolved from nodeA/server
DATA_DIR=./node_data
HIDDEN_SERVICE_DIR=../hidden_service

# Comma-separated bootstrap onion addresses (leave empty if none)
BOOTSTRAP_ONIONS=

# Onion route behavior
DEFAULT_RELAY_HOPS=2
DEFAULT_PACKET_TTL=8

# Security windows (milliseconds)
MAX_PACKET_AGE_MS=300000
MAX_PACKET_FUTURE_SKEW_MS=15000
MAX_PEER_ANNOUNCEMENT_AGE_MS=300000

# Relay hardening
ENFORCE_KNOWN_RELAY_TARGETS=true

# ACK retry worker tuning
ACK_RETRY_POLL_MS=3000
ACK_RETRY_MAX_ATTEMPTS=6
ACK_RETRY_BASE_BACKOFF_MS=2000
ACK_RETRY_MAX_BACKOFF_MS=60000
